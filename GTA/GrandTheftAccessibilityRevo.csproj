<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GrandTheftAccessibilityRevo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CSCore" Version="1.2.1.2" />
<PackageReference Include="NAudio" Version="1.10.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by tools/build-map-data.py; copied to bin so dotnet build can
         verify the data file is present and so test installs work directly. -->
    <None Include="scripts\gta11y-map.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Static dump of the GTA V vehicle path-node graph (~915 KB gzipped,
         67k+ nodes from DurtyFree/gta-v-data-dumps). Consumed by NodeGraph
         in MapDb.cs for the path-aware drive assist. -->
    <None Include="scripts\gta11y-nodes.json.gz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
