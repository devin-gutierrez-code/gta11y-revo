<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GrandTheftAccessibilityRevo</AssemblyName>
  </PropertyGroup>

  <!-- GTA V's ScriptHookVDotNet scripts folder. The game loads the mod from
       here, NOT from bin\, so every build is auto-copied in (see the
       DeployToGameScripts target below). Override on another machine with
       -p:Gta5ScriptsDir=... or a Gta5ScriptsDir environment variable. -->
  <PropertyGroup>
    <Gta5ScriptsDir Condition="'$(Gta5ScriptsDir)' == ''">D:\SteamLibrary\steamapps\common\Grand Theft Auto V\scripts</Gta5ScriptsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CSCore" Version="1.2.1.2" />
<PackageReference Include="NAudio" Version="1.10.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by tools/build-map-data.py; copied to bin so dotnet build can
         verify the data file is present and so test installs work directly. -->
    <None Include="scripts\gta11y-map.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Menu Reader label tables (tabs, menu screens, settings rows, phone
         apps). Generated by tools/build-menulabels.py from pausemenu.xml +
         the eMenuScreen enum; row uniqueIds filled in by calibration.
         Consumed by MenuLabelDb.cs. Editable + redeployable without rebuild. -->
    <None Include="scripts\gta11y-menulabels.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- iter-52: static world knowledge harvested from Rockstar's decompiled
         scripts (collectible coordinates, restricted-area boxes, Strangers &amp;
         Freaks trigger points, the interactable-prop catalogue, the random-event
         id registry). Generated by tools/build-worlddata.py; consumed by
         WorldDataDb.cs. None of this is queryable from natives at runtime. -->
    <None Include="scripts\gta11y-worlddata.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Static dump of the GTA V vehicle path-node graph (~915 KB gzipped,
         67k+ nodes from DurtyFree/gta-v-data-dumps). Consumed by NodeGraph
         in MapDb.cs for the path-aware drive assist. -->
    <None Include="scripts\gta11y-nodes.json.gz" CopyToOutputDirectory="PreserveNewest" />
    <!-- Signalized-junction templates (per-entrance turn rules, stop positions)
         extracted from the game's CJunctionTemplateArray via CodeWalker.
         Consumed by JunctionDb in MapDb.cs for the junction-approach assist. -->
    <None Include="scripts\gta11y-junctions.json.gz" CopyToOutputDirectory="PreserveNewest" />
    <!-- GTA V's own AI handling info table (Sports/Average/Crap/Truck +
         per-class curve angle->speed lookup). Bundled so VehicleAIHandling.cs
         can load it next to the DLL when the user doesn't override via
         ModSettings. -->
    <None Include="vehicleaihandlinginfo.meta" CopyToOutputDirectory="PreserveNewest" />
    <!-- Object/vehicle name lookup table, read from "scripts/hashes.txt" at
         startup (GTA11Y.cs). Lives outside the project folder, and until iter-41
         it was NOT in this list — so no build ever produced it and no deploy ever
         copied it. Existing installs only have it because it was placed by hand
         in 2022; a fresh clone or a clean machine silently lost vehicle and
         object naming, which for a blind user is a real loss, and the mod
         degrades quietly ("hashes file missing") rather than failing loudly.
         Link= puts it at scripts\hashes.txt in the build output so it matches
         the path the mod actually reads and the layout deploy.ps1 mirrors. -->
    <None Include="..\External Resources\hashes.txt" Link="scripts\hashes.txt"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- Earcons. Read from "scripts/<name>.wav" by the audio subsystem
         (GTA11Y.cs ~:4529+) through NAudio's AudioFileReader. Like hashes.txt
         these were hand-placed years ago and were never in the build, so a
         clean install had no target/pickup/cover/hit audio at all. Link= forces
         the lowercase names the code actually opens, since two of the source
         files are upper-case and Windows' case-insensitivity hid that. -->
    <None Include="..\External Resources\tped.wav"     Link="scripts\tped.wav"     CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\External Resources\tvehicle.wav" Link="scripts\tvehicle.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\External Resources\tprop.wav"    Link="scripts\tprop.wav"    CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\External Resources\pickup.wav"   Link="scripts\pickup.wav"   CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\External Resources\COVER.wav"    Link="scripts\cover.wav"    CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\External Resources\INTERACT.wav" Link="scripts\interact.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\External Resources\hit.wav"      Link="scripts\hit.wav"      CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\External Resources\headshot.wav" Link="scripts\headshot.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\External Resources\kill.wav"     Link="scripts\kill.wav"     CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\External Resources\door.wav"     Link="scripts\door.wav"     CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\External Resources\ladder.wav"   Link="scripts\ladder.wav"   CopyToOutputDirectory="PreserveNewest" />

    <!-- Tolk, the screen-reader abstraction the mod P/Invokes (GTA/Tolk.cs:
         [DllImport("Tolk.dll")]). This is the ENTIRE speech path for a blind
         user, and it is native, so it must sit in the GTA V ROOT next to
         GTA5.exe — DllImport resolves from the executable's directory, not from
         scripts\. It is deliberately NOT given a Link=scripts\ path.
         nvdaControllerClient64.dll and SAAPI64.dll are the screen-reader client
         libraries Tolk loads for NVDA and Dolphin/Supernova; without them Tolk
         silently falls back to SAPI only. The 32-bit variants are not used by
         the 64-bit game. Vendored under External Resources\native\ because they
         existed nowhere in this repo and so could never be packaged. -->
    <None Include="..\External Resources\native\Tolk.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\External Resources\native\nvdaControllerClient64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\External Resources\native\SAAPI64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- VehicleAIHandling.cs uses XDocument for parsing the bundled .meta XML. -->
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <!-- Post-build: copy the freshly built managed DLLs into the GTA V scripts
       folder so "built" becomes "testable". This is an ADDITIONAL copy — the
       bin\$(Configuration) output is left intact. Runs for any configuration
       (whatever you just built lands in-game). Skips silently when the folder
       isn't present (other machines / CI). ContinueOnError so a build while GTA
       is running (DLL locked) warns instead of failing. ScriptHookVDotNet3.dll
       is intentionally NOT deployed (it ships with SHVDN). Bundled map/handling
       DATA is not auto-deployed (it rarely changes and is already in place; use
       tools\deploy.ps1 -IncludeData for a first install). -->
  <Target Name="DeployToGameScripts" AfterTargets="Build" Condition="Exists('$(Gta5ScriptsDir)')">
    <Copy SourceFiles="$(OutDir)GrandTheftAccessibilityRevo.dll;$(OutDir)CSCore.dll;$(OutDir)NAudio.dll;$(OutDir)Newtonsoft.Json.dll"
          DestinationFolder="$(Gta5ScriptsDir)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <Message Importance="high" Text="GTA11Y: deployed DLLs to $(Gta5ScriptsDir)" />
  </Target>

</Project>
