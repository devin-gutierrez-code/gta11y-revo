{
  "_comment": "Road-type classification for build-map-data.py. The classifier first applies the 'overrides' table (exact name match wins), then falls back to suffix-based 'rules' for any unmatched name. Output types: freeway > highway > surface > alley. Names come from Foxxite/GTAV-Geo-Json street.geojson which uses the in-game name property.",

  "overrides": {
    "Great Ocean Hwy":         "freeway",
    "Los Santos Fwy":          "freeway",
    "La Puerta Fwy":           "freeway",
    "Olympic Fwy":             "freeway",
    "Del Perro Fwy":           "freeway",
    "Senora Fwy":              "freeway",
    "Palomino Fwy":            "freeway",
    "West Eclipse Blvd":       "highway",
    "Route 1":                 "highway",
    "Route 68":                "highway",
    "Cassidy Creek Hwy":       "highway",
    "Joshua Rd":               "highway",
    "Cassidy Trail":           "highway",
    "Tongva Dr":               "highway",
    "Senora Rd":               "highway",
    "Marina Dr":               "highway",
    "Mount Haan Dr":           "highway",
    "Galileo Rd":              "highway",
    "Calafia Way":             "highway",
    "Barbareno Rd":            "surface",
    "Banham Canyon Dr":        "highway",
    "Buccaneer Way":           "surface",
    "Vespucci Blvd":           "surface",
    "Pacific Bluffs":          "surface",
    "Vinewood Park Dr":        "highway"
  },

  "_rules_comment": "Suffix-based rules applied if not in overrides. Matched case-insensitive against the END of the road name (allowing for trailing whitespace).",
  "rules": [
    { "suffix": "Fwy",      "type": "freeway" },
    { "suffix": "Freeway",  "type": "freeway" },
    { "suffix": "Hwy",      "type": "highway" },
    { "suffix": "Highway",  "type": "highway" },
    { "suffix": "Blvd",     "type": "surface" },
    { "suffix": "Boulevard","type": "surface" },
    { "suffix": "Ave",      "type": "surface" },
    { "suffix": "Avenue",   "type": "surface" },
    { "suffix": "Dr",       "type": "surface" },
    { "suffix": "Drive",    "type": "surface" },
    { "suffix": "St",       "type": "surface" },
    { "suffix": "Street",   "type": "surface" },
    { "suffix": "Rd",       "type": "surface" },
    { "suffix": "Road",     "type": "surface" },
    { "suffix": "Way",      "type": "surface" },
    { "suffix": "Pl",       "type": "surface" },
    { "suffix": "Place",    "type": "surface" },
    { "suffix": "Ct",       "type": "surface" },
    { "suffix": "Court",    "type": "surface" },
    { "suffix": "Ln",       "type": "surface" },
    { "suffix": "Lane",     "type": "surface" },
    { "suffix": "Trail",    "type": "highway" },
    { "suffix": "Trl",      "type": "highway" },
    { "suffix": "Pkwy",     "type": "surface" },
    { "suffix": "Parkway",  "type": "surface" },
    { "suffix": "Aly",      "type": "alley" },
    { "suffix": "Alley",    "type": "alley" }
  ],

  "_default_comment": "Used when no override matches and no suffix rule matches.",
  "default_type": "surface",

  "_simplification_comment": "Polygon simplification: drop intermediate vertices whose perpendicular distance from the chord between their neighbors is less than this tolerance (in game units = meters). Higher = smaller file but coarser point-in-polygon test.",
  "polygon_simplify_tolerance": 6.0,

  "_min_keep_comment": "Don't emit roads whose entire polygon has fewer than this many vertices after simplification (drops tiny noise polygons).",
  "min_polygon_vertices": 4
}
